/loader.user.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=300

# Same rules as the loader. max-age stays short because Tampermonkey
# fetches @updateURL to compare versions — a long cache would delay every
# future update by the cache lifetime.
/sla.user.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=300

/mr.user.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=300

/pmc.user.js
  Content-Type: application/javascript; charset=utf-8
  Cache-Control: public, max-age=300

# Immutable: the filename is tied to Chivo v21's content hash upstream,
# so a new cut of the font arrives as a new file rather than as a change
# to this one. Pages infers font/woff2 from the extension; stating it
# removes the doubt.
/fonts/*
  Content-Type: font/woff2
  Cache-Control: public, max-age=31536000, immutable

# Applies to every page, not just the panel: the landing page is the one
# an attacker would reach first, and nosniff/Referrer-Policy cost nothing
# there. HSTS is set site-wide because both casereview.cc and
# api.casereview.cc are HTTPS-only — check any future subdomain can serve
# TLS before leaving includeSubDomains in place.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  # Framing is denied everywhere now, not just on the panel.
  # X-Frame-Options is the legacy half; frame-ancestors inside each CSP
  # is the half modern browsers read. Both, because the two are not read
  # by the same set of browsers.
  X-Frame-Options: DENY
  # Nothing on this site uses any of these. Denying them costs nothing
  # and means a future injected script cannot reach for them either.
  #
  # Cross-Origin-Resource-Policy is deliberately NOT here. All four
  # loaders -- loader/sla/mr/pmc.user.js -- are fetched cross-origin by
  # Tampermonkey on every update check, and a blanket CORP breaks every
  # client silently.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# The landing page. Everything it needs is same-origin now that
# index.css, index.js and the font were split out -- the ONE exception
# is the bootstrap at index.html:13, kept inline because a deferred file
# that failed to load would take every progressively-revealed section of
# the page with it. Its content is frozen, so the hash below carries no
# ongoing maintenance. If that line is ever edited the hash must be
# recomputed, or the page loses its "js" class and every hidden section
# stays hidden -- silently, with no console error worth noticing.
#
# style-src is split ON PURPOSE. index.html carries 61 inline style=""
# attributes -- meter fills, stagger indices, bar widths -- and a plain
# style-src 'self' drops every one of them, leaving empty meters and no
# visible error. style-src-elem is the half that matters: it governs
# <style> elements and stylesheet loads. A style ATTRIBUTE cannot
# execute script, so allowing those is cheap. The bare style-src stays
# as the fallback for browsers without the -elem/-attr split.
#
# connect-src names the API because index.js fetches /version and
# /sla/version to fill the version spans live. If the API hostname ever
# changes, this line changes with it or those spans silently fall back
# to their hardcoded values.
#
# Verified against the page when written: no <form> (so form-action
# 'none' is safe), no inline on* handlers (so script-src needs no
# 'unsafe-inline'), no dynamic script/image creation in index.js, and
# the only url() in index.css is the self-hosted font. The two <canvas>
# elements are JS-drawn and fetch nothing.
#
# Both paths are listed because Pages matches on the REQUEST path, and
# the page is reachable as / and as /index.html.
/
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-tHd4qJ0R/vQfI0CbRTiL3XGSi+Tun7VhOcDbx08aLKA='; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; connect-src https://api.casereview.cc; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/index.html
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-tHd4qJ0R/vQfI0CbRTiL3XGSi+Tun7VhOcDbx08aLKA='; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; connect-src https://api.casereview.cc; img-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/admin/*
  X-Robots-Tag: noindex
  # The panel holds an admin bearer token in sessionStorage, and nothing
  # else constrained what could read it. admin/index.html carries no
  # inline <style>, <script> or on* attribute — every handler is assigned
  # as a property from admin.js — so 'self' is enough and no
  # 'unsafe-inline' is needed. Verify that still holds before editing the
  # page: an inline style added later will silently fail to apply.
  #
  # connect-src names the API explicitly. If the API hostname ever
  # changes, this line has to change with it or every request in the
  # panel dies at the browser.
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; connect-src https://api.casereview.cc; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
